---
import { lanes, type Flow } from '../../lib/data';
import { layout, COL_W, LABEL_W, CARD_H, GAP } from '../../lib/layout';
import Card from './Card.astro';
const { flow } = Astro.props as { flow: Flow };
const { gridW, gridH, arrows, row } = layout(flow);
const sRow = row('singlify');
const cols = `${LABEL_W}em repeat(${flow.cols}, ${COL_W}em)`;
const rows = `repeat(${flow.lanes.length}, ${CARD_H}em)`;
const uid = `m-${flow.key}`;
---
<div class="lanegrid-wrap">
  <div class="lg-frame">
    {flow.bands && (
      <div class="lg-bands" aria-hidden="true">
        {flow.bands.map((b) => {
          const from = flow.stages[b.from].colStart;
          const last = flow.stages[b.to];
          const w = (last.colStart + last.span - from) * COL_W;
          return <div class="lg-band" style={`width:${w}em`}>{b.label}</div>;
        })}
      </div>
    )}
    <div class="lg" style={`grid-template-columns:${cols};grid-template-rows:${rows}`} role="group" aria-label="Swimlane diagram. The same steps are listed in order in the stage list for narrow screens.">
      {flow.lanes.map((l, i) => (
        <>
          <div class="lg-stripe" style={`grid-row:${i + 1}`}></div>
          <div class="lg-label" style={`grid-row:${i + 1};grid-column:1`}><strong>{lanes[l].label}</strong><span>{lanes[l].sub}</span></div>
        </>
      ))}
      <svg width={`${gridW}em`} height={`${gridH}em`} viewBox={`0 0 ${gridW} ${gridH}`} aria-hidden="true" focusable="false">
        <defs>
          <marker id={`${uid}-blue`} markerUnits="userSpaceOnUse" markerWidth="1" markerHeight="1" refX="1" refY="0.5" orient="auto"><path d="M0 0 L1 0.5 L0 1 Z" style="fill:var(--dark-blue)" /></marker>
          <marker id={`${uid}-grey`} markerUnits="userSpaceOnUse" markerWidth="1" markerHeight="1" refX="1" refY="0.5" orient="auto"><path d="M0 0 L1 0.5 L0 1 Z" style="fill:var(--dark-grey)" /></marker>
        </defs>
        {arrows.map((a) => (
          <path d={a.d} fill="none" stroke-width="0.14" stroke-dasharray={a.dashed ? '0.5 0.35' : undefined} style={`stroke:${a.kind === 'blue' ? 'var(--dark-blue)' : 'var(--dark-grey)'}`} marker-end={`url(#${uid}-${a.kind})`} />
        ))}
      </svg>
      {flow.stages.map((s, i) => (
        <>
          <Card kind="singlify" name={s.title} text={s.note} tag={`Stage ${i + 1}`} style={`grid-row:${sRow + 1};grid-column:${s.colStart + 2} / span ${s.span}`} />
          {s.attach.map((a) => (
            <Card kind={a.lane === 'member' ? 'member' : a.lane === 'team' ? 'team' : 'partner'} name={a.name} text={a.text} human={a.human} style={`grid-row:${row(a.lane) + 1};grid-column:${a.col + 2}`} />
          ))}
        </>
      ))}
    </div>
  </div>
</div>
